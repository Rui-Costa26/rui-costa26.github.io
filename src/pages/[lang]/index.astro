---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectPlate from '../../components/ProjectPlate.astro';
import Footer from '../../components/Footer.astro';
import photo from '../../assets/rui.jpg';
import { t, pick, month, LANGS, type Lang } from '../../i18n';
import { SITE } from '../../data/site';
import { projects } from '../../data/projects';
import { experience, skills, principles, aiPoints } from '../../data/profile';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const site = Astro.site!;
const when = (j: (typeof experience)[number]) => {
  if (j.years) return j.years;
  const s = month(lang, j.start);
  const e = j.end ? month(lang, j.end) : t(lang, 'xp.now');
  return `${s} – ${e}`;
};
const nav = [
  ['about', 'nav.about'], ['apps', 'nav.apps'], ['experience', 'nav.xp'], ['skills', 'nav.skills'], ['contact', 'nav.contact'],
] as const;
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Person', name: SITE.name,
    jobTitle: lang === 'pt' ? 'Programador iOS' : 'iOS developer',
    worksFor: { '@type': 'Organization', name: 'Bosch Portugal' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Instituto Politécnico do Cávado e do Ave' },
    address: { '@type': 'PostalAddress', addressLocality: SITE.locality, addressCountry: SITE.country },
    url: new URL(`/${lang}/`, site).href,
    image: new URL('/og/rui-costa.jpg', site).href,
    sameAs: [SITE.linkedin, SITE.github],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL('/', site).href, inLanguage: ['en', 'pt-PT'] },
];
---
<Base lang={lang} title={t(lang, 'meta.home.title')} description={t(lang, 'meta.home.desc')} path="" og={`/og/home-${lang}.png`} jsonld={jsonld}>
  <nav class="plots" aria-label={t(lang, 'nav.label')} slot="nav">
    {nav.map(([id, key]) => <a href={`#${id}`}><span class="tile" aria-hidden="true"></span><span>{t(lang, key)}</span></a>)}
  </nav>

  <div class="wrap" id="top">
    <div class="hero">
      <div>
        <h1><span>Rui Costa,</span> <span class="role">{t(lang, 'hero.role')}</span></h1>
        <p class="lead">{t(lang, 'hero.lead')}</p>
        <ul class="links">
          <li><a class="btn primary" href="#apps">{t(lang, 'hero.cta')}</a></li>
          <li><a class="btn" href={SITE.linkedin}>LinkedIn</a></li>
          <li><a class="btn" href={SITE.github}>GitHub</a></li>
        </ul>
      </div>
      <div class="board">
        <div class="t photo" style="--i:0">
          <Image src={photo} alt={t(lang, 'hero.photo')} widths={[320, 480, 640, 880]} sizes="(min-width: 900px) 320px, 62vw" format="webp" quality={80} loading="eager" fetchpriority="high" />
        </div>
        <a class="t t-cobalt" style="--i:1" href="#experience"><b>iOS</b><span>{t(lang, 't.ios')}</span></a>
        <a class="t t-yellow" style="--i:2" href="#apps"><b>{projects.length}</b><span>{t(lang, 't.apps')}</span></a>
        <a class="t t-white" style="--i:3" href="#experience"><b>Bosch</b><span>{t(lang, 't.bosch')}</span></a>
        <span class="t t-pattern" style="--i:4" aria-hidden="true"></span>
        <a class="t t-ink" style="--i:5" href="#ai"><b>{t(lang, 't.aib')}</b><span>{t(lang, 't.ai')}</span></a>
      </div>
    </div>
  </div>

  <section id="about" aria-labelledby="about-h"><div class="wrap">
    <div class="sec-head"><h2 id="about-h">{t(lang, 'about.h')}</h2></div>
    <div class="about">
      <div class="tray">
        <p>{t(lang, 'about.p1')}</p>
        <p>{t(lang, 'about.p2')}</p>
      </div>
      <ul class="principles" aria-label={t(lang, 'pr.label')}>
        {principles.map((p) => <li><h3>{pick(lang, p.title)}</h3><p>{pick(lang, p.text)}</p></li>)}
      </ul>
    </div>
    <div class="ai" id="ai">
      <div><h3>{t(lang, 'ai.h')}</h3><p class="big">{t(lang, 'ai.big')}</p></div>
      <ul>
        {aiPoints.map((p) => <li><b>{pick(lang, p.title)}</b><span>{pick(lang, p.text)}</span></li>)}
      </ul>
    </div>
  </div></section>

  <section id="apps" aria-labelledby="apps-h"><div class="wrap">
    <div class="sec-head"><h2 id="apps-h">{t(lang, 'apps.h')}</h2><p>{t(lang, 'apps.sub')}</p></div>
    {projects.map((p) => <ProjectPlate p={p} lang={lang} />)}
    {projects.length < 3 && (
      <div class="next"><span class="plot" aria-hidden="true"></span><p><b>{t(lang, 'next.h')}</b><span>{t(lang, 'next.p')}</span></p></div>
    )}
  </div></section>

  <section id="experience" aria-labelledby="xp-h"><div class="wrap">
    <div class="sec-head"><h2 id="xp-h">{t(lang, 'xp.h')}</h2></div>
    <ol class="xp" reversed>
      {experience.map((j) => (
        <li class={j.kind === 'education' ? 'edu' : undefined}>
          <span class="when">{when(j)}</span>
          <div><h3>{j.company}</h3><p>{pick(lang, j.text)}</p></div>
        </li>
      ))}
    </ol>
  </div></section>

  <section id="skills" aria-labelledby="sk-h"><div class="wrap">
    <div class="sec-head"><h2 id="sk-h">{t(lang, 'sk.h')}</h2><p>{t(lang, 'sk.sub')}</p></div>
    <div class="tray sk-tray">
      <table class="sk">
        <thead><tr><th scope="col">{t(lang, 'sk.c1')}</th><th scope="col">{t(lang, 'sk.c2')}</th></tr></thead>
        <tbody>
          {skills.map((s) => <tr><th scope="row">{pick(lang, s.name)}</th><td>{pick(lang, s.usedIn)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div></section>

  <section id="contact" aria-labelledby="ct-h"><div class="wrap">
    <div class="contact">
      <h2 id="ct-h">{t(lang, 'ct.h')}</h2>
      <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <ul class="links">
        <li><button class="btn primary" type="button" data-copy={SITE.email} data-done={t(lang, 'ct.copied')} hidden>{t(lang, 'ct.copy')}</button></li>
        <li><a class="btn" href={SITE.linkedin}>LinkedIn</a></li>
        <li><a class="btn" href={SITE.github}>GitHub</a></li>
      </ul>
      <p class="sr" role="status" aria-live="polite" data-copy-status></p>
    </div>
    <Footer lang={lang} />
  </div></section>
</Base>

<script>
  // Section nav: mark the section in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.plots a')];
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => {
      if (a.getAttribute('href') === '#' + e.target.id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  }), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id], #top').forEach((s) => io.observe(s));

  // Copy email (shown only where the clipboard API exists).
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (btn && navigator.clipboard) {
    btn.hidden = false;
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = btn.dataset.done!;
        if (status) status.textContent = btn.dataset.done!;
        setTimeout(() => { btn.textContent = label; if (status) status.textContent = ''; }, 1600);
      } catch {}
    });
  }
</script>
